# Hosted AI using a Groq Free-plan account. Never commit real credentials.
# Keep the Groq account on Free; do not upgrade billing for this configuration.
AI_VENDOR=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Shared daily inference-call cap when Redis is configured (each tool round counts).
GROQ_DAILY_REQUEST_LIMIT=100
# Other existing providers remain optional and require their own billing:
# AI_VENDOR=anthropic, ANTHROPIC_API_KEY, AI_MODEL
# AI_VENDOR=openai, OPENAI_API_KEY, AI_MODEL
